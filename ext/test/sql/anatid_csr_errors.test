# name: test/sql/anatid_csr_errors.test
# description: every way anatid's CSR functions are asked to do something they cannot, and the
#              error each one gives. Nothing here may crash.
# group: [anatid]

require anatid

# ---------------------------------------------------------------- no CSR built yet
# This file must build no CSR before this point: the object cache is per database.
statement error
SELECT * FROM graph_expand(0, 1, 2);
----
no CSR has been built for this database yet

# the stats functions are health probes, not errors: zero rows means "nothing loaded"
query I
SELECT count(*) FROM anatid_csr_stats();
----
0

query I
SELECT count(*) FROM anatid_csr_tenants();
----
0

# ---------------------------------------------------------------- bad build arguments
statement error
SELECT * FROM anatid_build_csr('no_such_table');
----
cannot read edge table 'no_such_table'

statement error
SELECT * FROM anatid_build_csr(NULL);
----
must not be NULL

statement error
SELECT * FROM anatid_build_csr('');
----
must not be empty

statement error
SELECT * FROM anatid_build_csr('a.b.c.d');
----
invalid table name

# a table without the required columns is named, along with what it does have
statement ok
CREATE TABLE wrong(a BIGINT, b BIGINT);

statement error
SELECT * FROM anatid_build_csr('wrong');
----
has no column 'tenant_id'

statement ok
CREATE TABLE rel(edge_id BIGINT, src BIGINT, dst BIGINT, tenant_id INTEGER, valid_to TIMESTAMP);

statement ok
INSERT INTO rel VALUES (0, 1, 2, 0, NULL), (1, 2, 3, 0, NULL), (2, 101, 102, 1, NULL);

# a failed build leaves the previous snapshot alone -- here there is none, so still no CSR
statement error
SELECT * FROM graph_expand(0, 1, 2);
----
no CSR has been built for this database yet

statement error
SELECT * FROM anatid_build_csr('rel', max_bytes := -1);
----
max_bytes must be >= 0

# a build budget too small to hold the CSR is refused, with the number it needed
statement error
SELECT * FROM anatid_build_csr('rel', max_bytes := 8);
----
over the limit of 8

statement error
SELECT * FROM graph_expand(0, 1, 2);
----
no CSR has been built for this database yet

query III
SELECT tenants, vertices, edges FROM anatid_build_csr('rel');
----
2	5	3

# ---------------------------------------------------------------- bad expand arguments
statement error
SELECT * FROM graph_expand(NULL, 1, 2);
----
must not be NULL

statement error
SELECT * FROM graph_expand(0, NULL, 2);
----
must not be NULL

statement error
SELECT * FROM graph_expand(0, 1, NULL);
----
must not be NULL

statement error
SELECT * FROM graph_expand(0, 1, -1);
----
hops must be >= 0

# ---------------------------------------------------------------- the hop limit
# 30 hops is the default ceiling (the bound Kuzu puts on a recursive join).
query I
SELECT count(*) FROM graph_expand(0, 1, 30);
----
3

statement error
SELECT * FROM graph_expand(0, 1, 31);
----
hops=31 exceeds the limit of 30

statement error
SELECT * FROM graph_expand(0, 1, 31);
----
Pass max_hops := 31 to allow it

# ... and it is a guard rail, not a wall
query I
SELECT count(*) FROM graph_expand(0, 1, 31, max_hops := 31);
----
3

statement error
SELECT * FROM graph_expand(0, 1, 2, max_hops := -1);
----
max_hops must be between 0 and 1000000

statement error
SELECT * FROM graph_expand(0, 1, 2, max_hops := 2000000);
----
max_hops must be between 0 and 1000000

statement error
SELECT * FROM graph_expand(0, 1, 2, max_hops := NULL);
----
max_hops must not be NULL

# max_hops := 0 forbids any traversal at all
statement error
SELECT * FROM graph_expand(0, 1, 1, max_hops := 0);
----
hops=1 exceeds the limit of 0

query II
SELECT entity_id, depth FROM graph_expand(0, 1, 0, max_hops := 0);
----
1	0

# ---------------------------------------------------------------- strict mode
# By default an unknown tenant or an unseen seed yields the seed alone, which is what anatid's
# pure-SQL expansion returns. strict := true turns each miss into a diagnosis.
query II
SELECT entity_id, depth FROM graph_expand(42, 1, 2);
----
1	0

statement error
SELECT * FROM graph_expand(42, 1, 2, strict := true);
----
tenant 42 has no edges in the CSR

statement error
SELECT * FROM graph_expand(42, 1, 2, strict := true);
----
CSR (unnamed) built from 'rel', 2 tenant(s) [0, 1], 3 edge(s)

statement error
SELECT * FROM graph_expand(0, 777, 2, strict := true);
----
seed 777 has no current edge in tenant 0

statement error
SELECT * FROM graph_expand(0, 777, 2, strict := true);
----
covers entity ids 1..3

# a seed that IS in the CSR is fine in strict mode
query II
SELECT entity_id, depth FROM graph_expand(0, 1, 1, strict := true) ORDER BY entity_id;
----
1	0
2	1

statement error
SELECT * FROM graph_expand(0, 1, 2, strict := NULL);
----
strict must not be NULL

# ---------------------------------------------------------------- sparse entity ids
# The offsets array costs 8 bytes per id in [min_id, max_id] whether an entity has that id or not,
# so ids sparse relative to the graph buy a huge array for a tiny graph. That is exactly the shape
# of anatid's default 63-bit time-ordered ids: two entities minted 10 ms apart are ~63,000,000 ids
# apart, half a gigabyte of offsets for one edge.
statement ok
CREATE TABLE sparse(src BIGINT, dst BIGINT, tenant_id INTEGER);

statement ok
INSERT INTO sparse VALUES (1, 1000000, 0);

statement error
SELECT * FROM anatid_build_csr('sparse');
----
has 1 current edge(s) but its entity ids span 1..1000000

statement error
SELECT * FROM anatid_build_csr('sparse');
----
max_span_factor := 0 to build it anyway

# the refusal left the previous snapshot alone
query T
SELECT edge_table FROM anatid_csr_stats();
----
rel

# it is a guard rail, not a wall
query III
SELECT tenants, vertices, edges FROM anatid_build_csr('sparse', max_span_factor := 0);
----
1	2	1

query II
SELECT entity_id, depth FROM graph_expand(0, 1, 1) ORDER BY entity_id;
----
1	0
1000000	1

statement error
SELECT * FROM anatid_build_csr('sparse', max_span_factor := -1);
----
max_span_factor must be between 0 (disabled) and 1000000

# a small span is always allowed, however few edges it holds
statement ok
CREATE TABLE tiny_span(src BIGINT, dst BIGINT, tenant_id INTEGER);

statement ok
INSERT INTO tiny_span VALUES (0, 999, 0);

query III
SELECT tenants, vertices, edges FROM anatid_build_csr('tiny_span');
----
1	2	1

# an id range the dense array cannot address at all is refused whatever the knobs say
statement ok
CREATE TABLE too_wide(src BIGINT, dst BIGINT, tenant_id INTEGER);

statement ok
INSERT INTO too_wide VALUES (-9223372036854775808, 9223372036854775807, 0);

statement error
SELECT * FROM anatid_build_csr('too_wide', max_span_factor := 0, max_bytes := 0);
----
more than 2147483648 apart
